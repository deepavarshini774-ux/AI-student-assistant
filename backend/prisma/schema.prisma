// Prisma schema for the AI Study Assistant
// Default datasource is SQLite so the project runs locally with zero setup.
// For production, switch provider to "postgresql" and point DATABASE_URL at your instance.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())

  conversations Conversation[]
  notes         Note[]
  studyPlans    StudyPlan[]
  documents     Document[]
}

// A single chat thread. A user can have many, supporting "multiple conversation support".
model Conversation {
  id         String    @id @default(uuid())
  title      String    @default("New conversation")
  topic      String?
  difficulty String    @default("Beginner") // Beginner | Intermediate | Advanced
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String

  messages   Message[]
  documents  Document[]
}

model Message {
  id             String   @id @default(uuid())
  role           String   // "user" | "assistant" | "system"
  content        String
  createdAt      DateTime @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
}

model Note {
  id             String   @id @default(uuid())
  topic          String
  content        String
  difficulty     String   @default("Beginner")
  createdAt      DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
}

model StudyPlan {
  id          String   @id @default(uuid())
  topic       String
  goalDays    Int      @default(7)
  difficulty  String   @default("Beginner")
  content     String   // JSON-encoded structured plan
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
}

model Quiz {
  id         String   @id @default(uuid())
  topic      String
  difficulty String   @default("Beginner")
  content    String   // JSON-encoded array of questions
  createdAt  DateTime @default(now())
  userId     String
}

// Uploaded text/PDF content, parsed to plain text, used to answer questions
// grounded in the uploaded material (bonus feature).
model Document {
  id             String   @id @default(uuid())
  filename       String
  extractedText  String
  createdAt      DateTime @default(now())

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  conversationId String?
}
